{
  "name": "severyn-portfolio",
  "description": "Portfolio landing site for Denys Severyn, built with Rivet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr && node prerender.js",
    "preview": "node serve.js",
    "check": "rivet sync && rivet-check && tsgo",
    "morph": "node scripts/morph.mjs"
  },
  "dependencies": {
    "@rivetjs/kit": "0.1.0-alpha.4",
    "@rivetjs/reactivity": "0.1.0-alpha.4",
    "@rivetjs/router": "0.1.0-alpha.4",
    "@rivetjs/runtime": "0.1.0-alpha.4",
    "lenis": "^1.3.27",
    "lucide": "^1.52.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@rivetjs/compiler": "0.1.0-alpha.4",
    "@rivetjs/devtools": "0.1.0-alpha.4",
    "@rivetjs/language-core": "0.1.0-alpha.4",
    "@rivetjs/typescript-plugin": "0.1.0-alpha.4",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
